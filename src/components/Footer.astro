---
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" translate="no">
          <span class="logo-i">i-</span><span class="logo-tools">Tools</span>
        </a>
        <p class="footer-tagline">
          Ferramentas inteligentes para simplificar seu dia.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Páginas">
        <h3 class="footer-nav-title">Links</h3>
        <ul class="footer-nav-list">
          <li><a href="/">Início</a></li>
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/contato">Contato</a></li>
          <li><a href="/privacidade">Privacidade</a></li>
          <li><a href="/termos">Termos de uso</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© 2026 i-Tools. Mantido por Vinicius Marques.</p>
      <p class="footer-note">O i-Tools é gratuito e mantido por anúncios.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-24);
    padding-block: var(--space-12);
    background: var(--color-grafite);
    color: var(--color-papel);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-papel);
    text-decoration: none;
  }

  .logo-i {
    color: var(--color-petroleo);
  }

  .footer-tagline {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ardosia);
    max-width: 32ch;
  }

  .footer-nav-title {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-nav-list a {
    font-size: var(--text-sm);
    color: var(--color-ardosia);
    transition: color var(--duration-fast) var(--easing);
  }

  .footer-nav-list a:hover {
    color: var(--color-papel);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-8);
    font-size: var(--text-xs);
    color: var(--color-ardosia);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-copy,
  .footer-note {
    margin: 0;
  }
</style>
