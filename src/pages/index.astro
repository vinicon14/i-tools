---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AdSlot from '../components/AdSlot.astro';
import { categories, getFeaturedTools, getToolsByCategory, countToolsByStatus } from '../data/tools';

const featuredTools = getFeaturedTools();
const availableCount = countToolsByStatus('disponivel');
const totalCount = countToolsByStatus('disponivel') + countToolsByStatus('em-breve');

const benefits = [
  {
    icon: 'check',
    title: 'Gratuito',
    text: 'Sem plano pago, sem teste que expira.',
  },
  {
    icon: 'check',
    title: 'Fácil',
    text: 'Uma tarefa por página, sem tutorial.',
  },
  {
    icon: 'check',
    title: 'Sem instalação',
    text: 'Funciona no celular e no computador.',
  },
  {
    icon: 'check',
    title: 'No navegador',
    text: 'Sempre que possível, seus arquivos são processados no seu aparelho.',
  },
];
---

<BaseLayout
  title="i-Tools — Ferramentas online gratuitas, direto no navegador"
  description="Ferramentas online gratuitas para gerar QR Codes, comprimir imagens, converter PDFs e muito mais. Sem cadastro, sem instalação."
  canonical="/"
>
  <section class="hero">
    <div class="container">
      <h1 class="hero-title text-balance">
        Ferramentas que resolvem o seu dia, direto no navegador.
      </h1>
      <p class="hero-subtitle">
        Gere QR Codes, ajuste imagens, converta PDFs e faça contas sem instalar nada e sem criar conta.
      </p>
      
      <div class="search-box">
        <label for="tool-search" class="search-label">O que você precisa fazer?</label>
        <div class="search-input-wrapper">
          <Icon name="search" size={20} class="search-icon" />
          <input
            type="search"
            id="tool-search"
            class="search-input"
            placeholder="Ex.: gerar QR Code…"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="quick-links">
        <span class="quick-links-label">Atalhos:</span>
        {featuredTools.slice(0, 4).map(tool => (
          <span class="quick-link-item">{tool.name}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="destaques">
    <div class="container">
      <div class="section-header">
        <span class="section-number">01</span>
        <h2 id="destaques" class="section-title">Na bancada</h2>
      </div>
      
      <ul class="tools-list">
        {featuredTools.map(tool => (
          <li class="tool-item">
            <div class="tool-icon-wrapper">
              <Icon name={tool.icon} size={24} />
            </div>
            <div class="tool-content">
              <h3 class="tool-name">{tool.name}</h3>
              <p class="tool-description">{tool.short}</p>
            </div>
            <span class="tool-status status-em-breve">Em breve</span>
          </li>
        ))}
      </ul>

      <p class="availability-note">
        <Icon name="check" size={16} />
        <strong>{availableCount} de {totalCount} disponíveis</strong> — lançamos com cuidado, uma ferramenta de cada vez.
      </p>
    </div>
  </section>

  <AdSlot />

  <section class="section" aria-labelledby="categorias" id="categorias">
    <div class="container">
      <div class="section-header">
        <span class="section-number">02</span>
        <h2 id="categorias" class="section-title">Por tipo de tarefa</h2>
      </div>

      <ul class="categories-list">
        {categories.map((category, index) => {
          const toolsCount = getToolsByCategory(category.slug).length;
          return (
            <li class="category-item">
              <div class="category-number">0{index + 1}</div>
              <div class="category-icon-wrapper">
                <Icon name={category.icon} size={20} />
              </div>
              <div class="category-content">
                <h3 class="category-name">{category.name}</h3>
                <p class="category-description">{category.description}</p>
              </div>
              <div class="category-count">
                <span class="visually-hidden">{toolsCount} ferramentas</span>
                <span aria-hidden="true">{toolsCount}</span>
              </div>
            </li>
          );
        })}
      </ul>

      <p class="availability-note">
        <Icon name="check" size={16} />
        Contador honesto: <strong>{availableCount} de {totalCount} disponíveis</strong> agora.
      </p>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="container">
      <div class="section-header">
        <span class="section-number">03</span>
        <h2 class="section-title">Por que usar</h2>
      </div>

      <ul class="benefits-grid">
        {benefits.map(benefit => (
          <li class="benefit-item">
            <Icon name={benefit.icon} size={24} class="benefit-icon" />
            <h3 class="benefit-title">{benefit.title}</h3>
            <p class="benefit-text">{benefit.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <AdSlot position="footer" />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-divisoria);
  }

  .hero-title {
    max-width: 24ch;
  }

  .hero-subtitle {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-texto-secundario);
    max-width: 60ch;
  }

  .search-box {
    margin-top: var(--space-12);
    max-width: 42rem;
  }

  .search-label {
    display: block;
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-texto);
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    color: var(--color-texto-secundario);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: var(--space-4);
    padding-left: calc(var(--space-4) + 20px + var(--space-3));
    background: var(--color-superficie);
    border: 1px solid var(--color-borda);
    border-radius: var(--radius-lg);
    font-family: var(--font-texto);
    font-size: var(--text-base);
    color: var(--color-texto);
    transition: all var(--duration-normal) var(--easing);
  }

  .search-input::placeholder {
    color: var(--color-texto-secundario);
  }

  .search-input:hover {
    border-color: var(--color-texto);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-foco);
    box-shadow: 0 0 0 3px rgba(15, 92, 110, 0.1);
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .quick-links-label {
    color: var(--color-texto-secundario);
  }

  .quick-link-item {
    padding: var(--space-1) var(--space-3);
    background: var(--color-superficie);
    border: 1px solid var(--color-divisoria);
    border-radius: var(--radius-md);
    color: var(--color-texto-secundario);
  }

  .section {
    padding-block: var(--space-16);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .section-number {
    font-family: monospace;
    font-size: var(--text-xs);
    color: var(--color-texto-secundario);
  }

  .section-title {
    font-size: var(--text-3xl);
  }

  .tools-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .tool-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-6);
    background: var(--color-superficie);
    border: 1px solid var(--color-divisoria);
    border-radius: var(--radius-md);
  }

  .tool-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: var(--color-fundo);
    border-radius: var(--radius-md);
    color: var(--color-link);
  }

  .tool-content {
    min-width: 0;
  }

  .tool-name {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .tool-description {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
  }

  .tool-status {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-em-breve {
    background: var(--color-sinal);
    color: var(--color-grafite);
  }

  .availability-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
  }

  .categories-list {
    list-style: none;
    border-top: 1px solid var(--color-divisoria);
  }

  .category-item {
    display: grid;
    grid-template-columns: 2rem 2rem 1fr auto;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-divisoria);
    transition: background var(--duration-fast) var(--easing);
  }

  .category-item:hover {
    background: var(--hover-bg);
  }

  .category-number {
    font-family: monospace;
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
    text-align: right;
  }

  .category-icon-wrapper {
    color: var(--color-texto-secundario);
  }

  .category-content {
    min-width: 0;
  }

  .category-name {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .category-description {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
  }

  .category-count {
    font-family: monospace;
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
  }

  .benefits-section {
    background: var(--color-fundo);
  }

  .benefits-grid {
    list-style: none;
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .benefit-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .benefit-icon {
    color: var(--color-link);
  }

  .benefit-title {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .benefit-text {
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 767px) {
    .category-item {
      grid-template-columns: 2rem 1fr auto;
    }
    
    .category-icon-wrapper {
      display: none;
    }
  }
</style>
