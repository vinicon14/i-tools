---
/**
 * Espaço reservado para anúncio.
 * Altura reservada para evitar CLS, sem script de anúncio real.
 */

type Props = {
  position?: 'home' | 'footer';
};

const { position = 'home' } = Astro.props;
---

<div class="ad-slot" data-ad-position={position}>
  <span class="ad-label">Publicidade</span>
  <div class="ad-placeholder">
    <p class="ad-placeholder-text">Espaço para anúncio</p>
  </div>
</div>

<style>
  .ad-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-block: var(--space-12);
    padding: var(--space-4);
  }

  .ad-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-texto-secundario);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ad-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 728px;
    min-height: 90px;
    background: var(--color-superficie);
    border: 1px dashed var(--color-divisoria);
    border-radius: var(--radius-md);
  }

  .ad-placeholder-text {
    font-size: var(--text-sm);
    color: var(--color-texto-secundario);
  }

  @media (min-width: 768px) {
    .ad-placeholder {
      min-height: 120px;
    }
  }
</style>
